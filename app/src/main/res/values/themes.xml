<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same base as before (Theme.NoTitleBar.Fullscreen) — only override is
         windowBackground. Cold start on TV hardware can take several seconds
         before Compose's first frame lands (class loading, no AOT profile on
         a fresh install), and the system paints this theme's windowBackground
         for the entire wait before that. The stock theme's default is a
         generic light-to-dark gray gradient that has nothing to do with this
         app, which read as "a long gray screen" before the real splash even
         though it's the same window the whole time. Matching it to
         AppBackground (#0D0D12) makes that unavoidable wait look like part of
         the splash instead of a jarring flash of unstyled content. -->
    <style name="AppTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/app_background</item>
    </style>
</resources>
